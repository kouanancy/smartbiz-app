NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Facultatif — utilisée uniquement par la tâche planifiée de rappel
# d'expiration d'abonnement (voir app/api/cron/expiration-reminders,
# « Centre de notifications » dans le README) pour prévenir un commerçant
# par e-mail. Sans cette clé, le rappel dans le centre de notifications
# (badge cloche) continue de fonctionner normalement, seul l'e-mail est
# ignoré. Ne sert plus à la notification admin de nouveau paiement,
# retirée au profit des notifications push ci-dessous (voir README,
# section « Notifications push (Web Push) »).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Doit provenir d'un domaine vérifié dans Resend pour un envoi fiable vers
# n'importe quelle adresse — la valeur par défaut (onboarding@resend.dev)
# ne fonctionne qu'en envoyant à l'adresse du compte Resend lui-même.
RESEND_FROM_EMAIL=Doka <notifications@tondomaine.com>

# Notifications push (Web Push) à l'administratrice quand un commerçant
# envoie un justificatif — voir README, section « Notifications push
# (Web Push) », pour la génération de ces clés et les étapes de
# configuration complètes (secrets Vault Supabase, redéploiement).
#
# Clé publique VAPID — exposée au navigateur (préfixe NEXT_PUBLIC_),
# utilisée lors de l'abonnement (bouton « Activer les notifications sur
# cet appareil » dans Paramètres, réservé aux comptes admin).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=une-cle-publique-vapid
# Clé privée VAPID — jamais exposée au navigateur, utilisée uniquement par
# app/api/push-admin-paiement pour signer l'envoi.
VAPID_PRIVATE_KEY=une-cle-privee-vapid
# Protège app/api/push-admin-paiement : cette route n'est appelée que
# depuis Supabase (pg_net), jamais depuis le navigateur — sans ce jeton,
# ou avec un jeton incorrect, elle refuse tout appel. Même valeur à
# renseigner dans le secret Vault "push_admin_secret" (éditeur SQL
# Supabase, voir README) : Supabase l'envoie alors en en-tête
# Authorization sur chaque appel, exactement comme CRON_SECRET ci-dessous
# pour le Cron Job Vercel.
PUSH_ADMIN_SECRET=une-chaine-aleatoire-longue

# Requises pour la tâche planifiée quotidienne de rappel d'expiration
# d'abonnement, et pour app/api/push-admin-paiement (lecture de
# push_subscriptions de tous les comptes admin, RLS contourné
# volontairement — voir les migrations SQL correspondantes). Sans elles,
# les routes refusent de s'exécuter plutôt que de tourner sans protection
# ou sans droits.
#
# Clé secrète (Project Settings > API dans Supabase) — jamais exposée au
# navigateur, seulement lue côté serveur.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Chaîne aléatoire de ton choix, à renseigner aussi dans les réglages Vercel
# du Cron Job (Project Settings > Environment Variables) — Vercel l'envoie
# alors automatiquement en en-tête Authorization sur chaque appel planifié,
# ce qui empêche quiconque d'autre de déclencher la route à volonté.
CRON_SECRET=une-chaine-aleatoire-longue
