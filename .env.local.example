NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Facultatif — notification par e-mail à l'administratrice quand un
# commerçant envoie un justificatif de paiement (voir « Paiement manuel
# vérifié » dans le README). Sans cette clé, l'envoi de justificatif
# fonctionne quand même : seule la notification est ignorée, l'admin voit
# de toute façon les paiements en attente dans l'espace Administration.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Doit provenir d'un domaine vérifié dans Resend pour un envoi fiable vers
# n'importe quelle adresse admin — la valeur par défaut (onboarding@resend.dev)
# ne fonctionne qu'en envoyant à l'adresse du compte Resend lui-même.
RESEND_FROM_EMAIL=Doka <notifications@tondomaine.com>

# Requises pour la tâche planifiée quotidienne de rappel d'expiration
# d'abonnement (voir app/api/cron/expiration-reminders, « Centre de
# notifications » dans le README). Sans elles, la route refuse de
# s'exécuter plutôt que de tourner sans protection ou sans droits.
#
# Clé secrète (Project Settings > API dans Supabase) — jamais exposée au
# navigateur, seulement lue côté serveur pour parcourir toutes les
# boutiques (RLS contourné volontairement, voir la migration SQL).
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Chaîne aléatoire de ton choix, à renseigner aussi dans les réglages Vercel
# du Cron Job (Project Settings > Environment Variables) — Vercel l'envoie
# alors automatiquement en en-tête Authorization sur chaque appel planifié,
# ce qui empêche quiconque d'autre de déclencher la route à volonté.
CRON_SECRET=une-chaine-aleatoire-longue
